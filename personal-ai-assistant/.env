# Personal AI Assistant — Environment Variables

# Model to use — any litellm-compatible model string:
#   OpenAI:    gpt-4o-mini, gpt-4.1, o4-mini, ...
#   Google:    gemini/gemini-2.0-flash, gemini/gemini-1.5-pro, ...
#   Groq/Meta: groq/llama-3.3-70b-versatile, groq/llama-3.1-8b-instant, ...
#   Anthropic: anthropic/claude-sonnet-4-6, ...
MODEL=gpt-4.1

# API key for the model's provider
OPENAI_API_KEY=sk-proj-nxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI key — only needed for PDF search (text-embedding-3-small).
# If MODEL is an OpenAI model, copy the same value from API_KEY above.
OPENAI_API_KEY=sk-proj-nxxxxxxxxxxxxxxxxxxxxxxxx

