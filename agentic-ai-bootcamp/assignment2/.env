# ─────────────────────────────────────────────────────────────────
# Personal Financial AI Agent — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────

# ── Model Selection (via LiteLLM) ────────────────────────────────
# LiteLLM uses a "provider/model" format.
# Change this single value to switch between providers.

LLM_MODEL=openai/gpt-4.1

# Other supported options (uncomment to use):
# LLM_MODEL=anthropic/claude-sonnet-4-6
# LLM_MODEL=ollama/llama3        # requires local Ollama running
# LLM_MODEL=openai/gpt-4o-mini   # cheaper OpenAI option

# ── API Keys ─────────────────────────────────────────────────────
# Only the key for the selected provider is required.

OPENAI_API_KEY=your-openai-api-key-here

# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# No API key needed for Ollama (runs locally).
# No API key needed for Stock Price tool (uses Yahoo Finance).
