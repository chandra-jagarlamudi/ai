# Meeting Notes Analyzer — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# Model used for all analysis agents (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# ── LangSmith Observability ──────────────────────────────
# Sign up at https://smith.langchain.com to get an API key.
# When enabled, every node execution is traced in LangSmith.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=meeting-analyzer
