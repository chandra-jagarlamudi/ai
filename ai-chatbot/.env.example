# ── Hugging Face ──────────────────────────────────────────────────────────────
HF_API_TOKEN=hf_...
HF_PROVIDER=featherless-ai
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-pro

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen3:8b-q4_K_M

# Local dev (default — Ollama running on your machine):
OLLAMA_BASE_URL=http://localhost:11434

# Docker dev (uncomment when running via docker compose):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Storage ───────────────────────────────────────────────────────────────────
# Path to the SQLite file that stores chat history.
# When running in Docker this maps to the volume-mounted path.
CHAT_DB_PATH=data/chat_history.db
