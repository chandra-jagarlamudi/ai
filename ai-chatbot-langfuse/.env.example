# Copy to .env and fill in values. Do not commit .env.

# --- Langfuse (required) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# If Langfuse is self-hosted on your machine and this app runs in the dev container:
# LANGFUSE_BASE_URL=http://host.docker.internal:3000

# --- OpenAI tab ---
# OPENAI_API_KEY=

# --- Gemini tab ---
# GOOGLE_API_KEY=

# --- Hugging Face tab (API or local) ---
# HF_API_TOKEN=
# USE_LOCAL_MODEL=true
# HF_DEVICE=auto
# HF_MAX_TOKENS=512
# HF_USE_8BIT=false
HF_PROVIDER=featherless-ai

# --- Ollama tab (ensure ollama serve is running) ---
# OLLAMA_BASE_URL=http://localhost:11434

# --- Model names (optional; change to use a different model per tab) ---
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-2.0-flash
# Must be a chat/instruction model (*-it, *-Instruct), not a base model (*-pt)
# HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# OLLAMA_MODEL=llama2